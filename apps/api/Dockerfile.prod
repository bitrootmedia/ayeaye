# The deployed API image. Also runs the `migrate` one-shot and the worker —
# same image, different command, so they can never drift apart.
FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /app

# Deps only: no --reload watcher, no dev extras.
COPY pyproject.toml ./
RUN uv sync --no-install-project --no-dev

COPY src ./src
COPY alembic.ini ./
COPY alembic ./alembic

EXPOSE 8000

# Two workers for throughput. Not published to the host — Caddy reaches it on
# the internal network.
CMD ["uv", "run", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "2", "--app-dir", "src"]
