# The deployed frontend: build with pnpm, serve the static files with nginx.
FROM node:22-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Deliberately no VITE_* build arguments. The bundle falls back to
# window.location.origin at runtime (see src/config.ts), so ONE image runs on
# any hostname — which is what makes self-hosting a `docker compose up` rather
# than a rebuild with your own domain baked in.
RUN pnpm build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
