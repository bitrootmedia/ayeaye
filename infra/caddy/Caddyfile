# One site. One hostname. That is a product decision, not a simplification —
# there is no backoffice and no second surface to give a host of its own, so
# the SPA, the API, the auth routes and every future upload share an origin.
#
# What that buys, all of it load-bearing:
#   * the session cookie is first-party, so none of the cross-site cookie
#     rules apply and nothing breaks when a browser tightens them;
#   * CORS is a formality — there is no cross-origin request to allow;
#   * a self-hoster needs exactly one DNS record and one certificate.
#
# SITE_URL carries the scheme on purpose. `http://localhost` tells Caddy to
# serve plain HTTP with no certificate, so the app works on a laptop with zero
# edits; `https://tasks.example.com` turns on automatic HTTPS via Let's Encrypt.
# One variable, and it is the same one the API is configured from.

{
	email {$ACME_EMAIL}
}

{$SITE_URL} {
	# The API, the auth routes (/api/auth/*) and, later, websockets — Caddy
	# proxies upgrades transparently.
	handle /api/* {
		reverse_proxy api:8000
	}

	# MCP, for somebody's own assistant. Same origin as everything else, so a
	# self-hoster gets it on the one hostname they already configured — and it
	# is authenticated by a personal access token rather than the session
	# cookie, because an MCP client is not a browser.
	#
	# `flush_interval -1` disables response buffering: the transport streams,
	# and a buffering proxy turns a stream into a request that appears to hang.
	handle /mcp* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# The liveness probe. Routed explicitly because it lives at the root:
	# without this rule it falls through to the SPA below and an uptime
	# monitor reports a cheerful 200 while the API is flat on its back.
	handle /health {
		reverse_proxy api:8000
	}

	# OAuth discovery — real documents now, served by the API like /health.
	# See `api/routers/wellknown.py` and CLAUDE.md's OAuth section.
	#
	# Without this rule, `/.well-known/oauth-*` falls through to the SPA
	# catch-all below and answers 200 with the app's own HTML. An OAuth-aware
	# client reads that 200 as "this server publishes protected-resource
	# metadata", tries to parse the HTML as that metadata, and fails —
	# `anthropics/claude-ai-mcp#457` traced the identical symptom
	# ("Couldn't register with …'s sign-in service") to exactly this on a
	# different server. Note the *path-inserted* form per RFC 9728
	# (`/.well-known/oauth-protected-resource/mcp`, not just the bare
	# document) — the exact request an OAuth-aware connector makes, and the
	# one it's easy to test for and miss testing against.
	@oauth_metadata path /.well-known/oauth-authorization-server* /.well-known/oauth-protected-resource*
	handle @oauth_metadata {
		reverse_proxy api:8000
	}

	# `openid-configuration` stays 404 forever — this is an OAuth 2.1
	# authorization server issuing scoped API access tokens, not an OIDC
	# identity provider. No id_token, no "sign in with ayeaye"; a 200 here
	# would claim a capability this server doesn't have.
	@openid_discovery path /.well-known/openid-configuration*
	handle @openid_discovery {
		respond 404
	}

	# Object storage. NOT handle_path — the prefix must survive. The bucket is
	# called `media`, so with path-style addressing the object URL is literally
	# /media/<key>, and that path is covered by the presigned signature.
	# Stripping it would break every upload and every download.
	#
	# Same origin as the app that uploads, so browser uploads need no CORS at
	# all — which is the entire class of preflight problem the reference
	# project had to work around on the client.
	handle /media/* {
		reverse_proxy rustfs:9000
	}

	# The SPA. MUST stay last — `handle` with no matcher is the catch-all, and
	# anything written after it is unreachable.
	#
	# WEB_PORT is 80 (nginx serving the built bundle) in production and 5173
	# (the Vite dev server) in development, which is how dev gets the exact
	# same single origin instead of a second port and a CORS allowlist.
	handle {
		reverse_proxy web:{$WEB_PORT:80}
	}
}
