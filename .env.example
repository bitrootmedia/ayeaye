# Copy this to .env and you have a working stack:
#
#   cp .env.example .env && docker compose up -d
#
# Every value below works as-is on a laptop. To put it on a real domain, edit
# the two variables in the first section and nothing else.
#
# This file IS the documentation, so it is committed. `.env` never is.

# --- the two you edit to go live --------------------------------------------

# Where the whole product lives — the app, the API and the auth routes, all on
# this one origin. Include the scheme: with `http://` Caddy serves plain HTTP
# (no certificate, works on localhost immediately); with `https://` it issues
# and renews a Let's Encrypt certificate automatically.
SITE_URL=http://localhost

# Let's Encrypt's contact address, used only when SITE_URL is https. It has to
# be non-empty either way — Caddy won't start with a blank one.
ACME_EMAIL=you@example.com

# --- secrets ------------------------------------------------------------------
# CHANGE BOTH before putting this on a public network. Nothing below is
# published to the host in production — Caddy is the only service with a port —
# but a default password in a compose file is still a default password.
#
#   openssl rand -hex 24
#
POSTGRES_PASSWORD=dev-only-change-me
# Shared secret between the API and the SuperTokens core. Must be at least 20
# characters; letters, digits and hyphens only.
SUPERTOKENS_API_KEY=dev-only-change-me-0123456789

# Object storage, for files attached to comments. Same reasoning as above:
# change these before this is reachable from anywhere but your laptop.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=dev-only-change-me

# Rarely worth changing. The database name and user are internal.
POSTGRES_USER=app
POSTGRES_DB=app

# --- email (optional) ---------------------------------------------------------
# Leave SMTP_HOST empty and the app logs what it would have sent, then carries
# on. That is a supported way to run this: invites also produce a copyable link
# in the UI, and a password-reset link appears in `docker compose logs api`.
#
# In development you can ignore this section entirely — the dev override points
# everything at Mailpit and you read the mail at http://localhost:8025.
#
# In production, MAIL_FROM must be on a domain your provider has verified or
# every message is rejected at submission.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
MAIL_FROM=
