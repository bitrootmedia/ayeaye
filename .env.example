# Copy this to .env and you have a working stack:
#
#   cp .env.example .env && docker compose up -d
#
# Every value below works as-is on a laptop. To put it on a real domain, edit
# the two variables in the first section and nothing else. `scripts/setup.sh`
# writes all of this for you, with generated secrets, which is the normal way
# to produce a .env rather than copying this file by hand.
#
# This file IS the documentation, so it is committed. `.env` never is.

# --- the two you edit to go live --------------------------------------------

# Where the whole product lives — the app, the API and the auth routes, all on
# this one origin. Include the scheme: with `http://` Caddy serves plain HTTP
# (no certificate, works on localhost immediately); with `https://` it issues
# and renews a Let's Encrypt certificate automatically.
SITE_URL=http://localhost

# Let's Encrypt's contact address, used only when SITE_URL is https. It has to
# be non-empty either way — Caddy won't start with a blank one.
ACME_EMAIL=you@example.com

# --- what runs in this stack, versus somewhere else -------------------------
# Postgres and object storage are the two pieces you might already have —
# a managed database, an S3 bucket. Removing a name here stops this compose
# file from starting that container at all; DATABASE_URL / S3_ENDPOINT below
# then have to point somewhere real. `scripts/setup-interactive.sh` walks
# through bringing your own of either one; leave this alone to run both here,
# which is the default and the only thing `scripts/setup.sh` sets up.
COMPOSE_PROFILES=local-db,local-storage

# --- secrets ------------------------------------------------------------------
# CHANGE ALL of these before putting this on a public network. Nothing below is
# published to the host in production — Caddy is the only service with a port —
# but a default password in a compose file is still a default password.
#
#   openssl rand -hex 24
#
# Shared secret between the API and the SuperTokens core. Must be at least 20
# characters; letters, digits and hyphens only.
SUPERTOKENS_API_KEY=dev-only-change-me-0123456789

# --- database -----------------------------------------------------------------
# What every service other than the bundled Postgres container actually
# connects to. With `local-db` in COMPOSE_PROFILES above, `scripts/setup.sh`
# points both of these at the bundled container using the POSTGRES_* values
# below — the two blocks describe the same database and have to be edited
# together if you touch either by hand.
#
# For a managed instance: drop `local-db` above, then point these at it
# directly. SuperTokens keeps identity in its OWN database on the same server
# (never the app's) — create it once yourself: `CREATE DATABASE supertokens;`.
# Both URLs take a query string, so add `?sslmode=require` if your provider
# needs it.
DATABASE_URL=postgresql://app:dev-only-change-me@postgres:5432/app
SUPERTOKENS_DATABASE_URL=postgresql://app:dev-only-change-me@postgres:5432/supertokens

# Only read by the bundled Postgres container, to initialise itself — a
# managed instance already exists and ignores these entirely. Keep them in
# sync with DATABASE_URL above; `scripts/setup.sh` does this for you.
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=app

# --- object storage -------------------------------------------------------
# What the API and worker actually connect to, for files attached to comments.
# `s3_public_endpoint` is what PRESIGNED URLS ARE SIGNED AGAINST — SigV4 covers
# the Host header, so it must be the address the *browser* reaches storage at,
# not necessarily the one the API does. Both default to the bundled RustFS,
# reached through Caddy on this site's own origin, which is what lets uploads
# skip CORS entirely.
#
# For a managed, S3-compatible provider: drop `local-storage` above, then
# point these at it. Its endpoint is now a DIFFERENT origin from SITE_URL, so
# uploads are no longer same-origin — add a CORS rule on the bucket allowing
# PUT/GET from SITE_URL, or every upload fails in the browser before it
# reaches storage. Real AWS S3 also needs virtual-hosted addressing in any
# region opened after 2020; this product signs path-style only, so a bucket in
# one of those regions won't work without a code change.
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=dev-only-change-me

# Only read by the bundled RustFS container, to initialise itself — deliberately
# a SEPARATE pair from S3_ACCESS_KEY / S3_SECRET_KEY above, which describe
# whatever storage the app is actually configured to use. In the default,
# local-storage setup those describe this same container, so `scripts/setup.sh`
# fills in both pairs identically.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=dev-only-change-me

# --- email (optional) ---------------------------------------------------------
# Leave SMTP_HOST empty and the app logs what it would have sent, then carries
# on. That is a supported way to run this: invites also produce a copyable link
# in the UI, and a password-reset link appears in `docker compose logs api`.
#
# In development you can ignore this section entirely — the dev override points
# everything at Mailpit and you read the mail at http://localhost:8025.
#
# In production, MAIL_FROM must be on a domain your provider has verified or
# every message is rejected at submission.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
MAIL_FROM=
